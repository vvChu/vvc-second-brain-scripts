scripts/_sync_manifest.json
scripts/logs/
scripts/.state/
scripts/knowledge_graph/graph_data.json
scripts/knowledge_graph/graph_data.js

# --- Obsidian Core & Syncthing ---
.obsidian/
.trash/

# --- Personal Knowledge Layers (EXCLUDE FROM GIT) ---
00 - Maps of Content/
01 - Projects/
02 - Areas/
03 - Resources/
04 - Permanent/
05 - Fleeting/
99 - Archive/

# Legacy and redundant directories
concepts/
sources/
wiki/
